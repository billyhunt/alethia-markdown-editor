{
  "$description": "Alethia design tokens in the Design Tokens Community Group (DTCG) Format Module 2025.10. $value is the light-mode value; semantic colours also carry their dark-mode alias under $extensions[\"com.alethia.mode\"] (vendor data, aliases into palette). alethia.css exposes the same tokens as CSS custom properties. The app's stylesheets in src/renderer/styles are the source of truth; when they change, update this file and alethia.css together.",
  "palette": {
    "$type": "color",
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.949, 0.9412, 0.9216],
        "hex": "#f2f0eb"
      },
      "$description": "Warm off-white ground. Never pure white on screen."
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0667, 0.0667, 0.0667],
        "hex": "#111111"
      },
      "$description": "Near-black. Text, rules and inverted bands."
    },
    "black": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      },
      "$description": "The code well in dark mode only."
    },
    "hot": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.2314, 0],
        "hex": "#ff3b00"
      },
      "$description": "The spot colour. A fill under ink, or text on black. Never text on paper (3.14:1)."
    },
    "hot-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.3412, 0.1333],
        "hex": "#ff5722"
      },
      "$description": "Dark-mode accent: the hot orange lifted for text on ink (5.97:1)."
    },
    "hot-tint": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.5686, 0.4],
        "hex": "#ff9166"
      },
      "$description": "One lighter step of the same hue. Code types only."
    },
    "rust": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7098, 0.1608, 0],
        "hex": "#b52900"
      },
      "$description": "Light-mode accent: the hot orange darkened for text on paper (5.62:1)."
    },
    "stone": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.3725, 0.3608, 0.3333],
        "hex": "#5f5c55"
      },
      "$description": "Muted text on paper (5.86:1)."
    },
    "stone-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6392, 0.6275, 0.6],
        "hex": "#a3a099"
      },
      "$description": "Muted text on ink (7.23:1)."
    },
    "ash": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5412, 0.5294, 0.502],
        "hex": "#8a8780"
      },
      "$description": "Code comments and operators on black."
    },
    "sand": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8471, 0.8118, 0.7529],
        "hex": "#d8cfc0"
      },
      "$description": "Code strings: dimmed paper."
    },
    "blush": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9608, 0.8784, 0.8392],
        "hex": "#f5e0d6"
      },
      "$description": "Light-mode selection and hover."
    },
    "ember": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2902, 0.1412, 0.0941],
        "hex": "#4a2418"
      },
      "$description": "Dark-mode selection and hover."
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{palette.paper}",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.paper}", "dark": "{palette.ink}" }
      }
    },
    "text": {
      "$value": "{palette.ink}",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.ink}", "dark": "{palette.paper}" }
      }
    },
    "text-muted": {
      "$value": "{palette.stone}",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.stone}", "dark": "{palette.stone-light}" }
      }
    },
    "border": {
      "$value": "{palette.ink}",
      "$description": "Rules, and the fill of every inverted band (titlebar, active tab, table head, badge).",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.ink}", "dark": "{palette.paper}" }
      }
    },
    "accent": {
      "$value": "{palette.rust}",
      "$description": "The orange that is readable as text on the current ground.",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.rust}", "dark": "{palette.hot-light}" }
      }
    },
    "accent-hot": {
      "$value": "{palette.hot}",
      "$description": "The signal fill. Same in both modes.",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.hot}", "dark": "{palette.hot}" }
      }
    },
    "on-hot": {
      "$value": "{palette.ink}",
      "$description": "Text on accent-hot. Same in both modes.",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.ink}", "dark": "{palette.ink}" }
      }
    },
    "on-accent": {
      "$value": "{palette.paper}",
      "$description": "Text on accent (inline code). Flips because accent flips.",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.paper}", "dark": "{palette.ink}" }
      }
    },
    "selection": {
      "$value": "{palette.blush}",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.blush}", "dark": "{palette.ember}" }
      }
    },
    "code-bg": {
      "$value": "{palette.ink}",
      "$extensions": {
        "com.alethia.mode": { "light": "{palette.ink}", "dark": "{palette.black}" }
      }
    },
    "code-fg": { "$value": "{palette.paper}" },
    "code-keyword": { "$value": "{palette.hot}" },
    "code-number": { "$value": "{palette.hot}" },
    "code-property": { "$value": "{palette.hot}" },
    "code-type": { "$value": "{palette.hot-tint}" },
    "code-string": { "$value": "{palette.sand}" },
    "code-function": { "$value": "{palette.paper}" },
    "code-comment": { "$value": "{palette.ash}" },
    "code-operator": { "$value": "{palette.ash}" }
  },
  "font": {
    "$type": "fontFamily",
    "prose": { "$value": ["Archivo", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"] },
    "display": { "$value": ["Archivo Black", "Archivo", "Impact", "system-ui", "sans-serif"] },
    "mono": { "$value": ["DM Mono", "ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "monospace"] }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": {
      "$value": 500,
      "$description": "DM Mono only: labels, active rows, table heads."
    },
    "semibold": {
      "$value": 600,
      "$description": "Archivo only: strong emphasis."
    }
  },
  "font-size": {
    "$type": "dimension",
    "body": { "$value": { "value": 1, "unit": "rem" } },
    "micro": {
      "$value": { "value": 0.62, "unit": "rem" },
      "$description": "Pin actions, the Recent list heading."
    },
    "label": {
      "$value": { "value": 0.66, "unit": "rem" },
      "$description": "Tabs, status bar, badges."
    },
    "ui": {
      "$value": { "value": 0.7, "unit": "rem" },
      "$description": "Buttons, toolbar, workspace switcher, fence labels."
    },
    "note": {
      "$value": { "value": 0.72, "unit": "rem" },
      "$description": "Titlebar name, banners, empty states."
    },
    "row": {
      "$value": { "value": 0.75, "unit": "rem" },
      "$description": "List rows and inputs."
    },
    "panel": {
      "$value": { "value": 0.78, "unit": "rem" },
      "$description": "Search panel."
    }
  },
  "font-scale": {
    "$type": "number",
    "$description": "Text scale for content, as multiples of the parent's font size (CSS em). Multiply by the body size; a dimension token cannot hold em.",
    "h1": { "$value": 2.3 },
    "h2": { "$value": 1.55 },
    "h3": { "$value": 1.2 },
    "h4": { "$value": 1.02 },
    "h5-h6": { "$value": 0.85 },
    "quote": { "$value": 1.05 },
    "inline-code": { "$value": 0.88 },
    "code-block": { "$value": 0.85 },
    "table": { "$value": 0.85 }
  },
  "tracking": {
    "$type": "number",
    "$description": "Letter-spacing as multiples of the element's font size (CSS em).",
    "display": {
      "$value": -0.02,
      "$description": "Display caps, h1 to h3."
    },
    "row": { "$value": 0.02 },
    "toolbar": {
      "$value": 0.06,
      "$description": "Toolbar buttons and the workspace switcher."
    },
    "button": { "$value": 0.08 },
    "label": {
      "$value": 0.1,
      "$description": "Titlebar, status bar, badges."
    },
    "table-head": { "$value": 0.12 },
    "fence": { "$value": 0.16 }
  },
  "line-height": {
    "$type": "number",
    "prose": { "$value": 1.65 },
    "display": { "$value": 1.05 },
    "quote": { "$value": 1.35 },
    "mono-heading": { "$value": 1.5 }
  },
  "rule": {
    "$type": "dimension",
    "thin": {
      "$value": { "value": 2, "unit": "px" },
      "$description": "Control borders, table cells, toolbar group dividers, text cursor."
    },
    "structural": {
      "$value": { "value": 3, "unit": "px" },
      "$description": "Pane edges, bar edges, tab underline."
    },
    "heavy": {
      "$value": { "value": 6, "unit": "px" },
      "$description": "Horizontal rule in prose."
    },
    "slab": {
      "$value": { "value": 8, "unit": "px" },
      "$description": "Blockquote slab."
    }
  },
  "size": {
    "$type": "dimension",
    "titlebar": { "$value": { "value": 38, "unit": "px" } },
    "sidebar": {
      "$value": { "value": 260, "unit": "px" },
      "$description": "Default; the user can resize it."
    },
    "measure": {
      "$value": { "value": 46, "unit": "rem" },
      "$description": "The writing column."
    },
    "gap": {
      "$value": { "value": 1.65, "unit": "rem" },
      "$description": "One empty line of body text; the gap between blocks."
    },
    "icon-button": { "$value": { "value": 26, "unit": "px" } },
    "dirty-mark": { "$value": { "value": 7, "unit": "px" } },
    "list-gutter": {
      "$value": 1.6,
      "$type": "number",
      "$description": "Hang gutter per list level, as a multiple of the font size (CSS em)."
    },
    "indent-step": {
      "$value": { "value": 12, "unit": "px" },
      "$description": "Per tree or outline level, after an 8px base."
    },
    "radius": {
      "$value": { "value": 0, "unit": "px" },
      "$description": "Everywhere. The macOS app-icon mask is the only curve."
    }
  },
  "duration": {
    "$type": "duration",
    "dim": {
      "$value": { "value": 200, "unit": "ms" },
      "$description": "Focus-mode dimming. The only animation in the app."
    }
  }
}
