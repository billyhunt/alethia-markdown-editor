{
  "$description": "Alethia design tokens (W3C Design Tokens Community Group format). Semantic colours have a light and a dark value; alethia.css exposes them under the same names as CSS custom properties.",
  "palette": {
    "$type": "color",
    "paper": { "$value": "#f2f0eb", "$description": "Warm off-white ground. Never pure white on screen." },
    "ink": { "$value": "#111111", "$description": "Near-black. Text, rules and inverted bands." },
    "black": { "$value": "#000000", "$description": "The code well and panels in dark mode only." },
    "hot": { "$value": "#ff3b00", "$description": "The spot colour. A fill under ink, or text on black. Never text on paper (3.14:1)." },
    "hot-light": { "$value": "#ff5722", "$description": "Dark-mode accent: the hot orange lifted for text on ink (5.97:1)." },
    "hot-tint": { "$value": "#ff9166", "$description": "One lighter step of the same hue. Code types only." },
    "rust": { "$value": "#b52900", "$description": "Light-mode accent: the hot orange darkened for text on paper (5.62:1)." },
    "stone": { "$value": "#5f5c55", "$description": "Muted text on paper (5.86:1)." },
    "stone-light": { "$value": "#a3a099", "$description": "Muted text on ink (7.23:1)." },
    "ash": { "$value": "#8a8780", "$description": "Code comments and operators on black." },
    "sand": { "$value": "#d8cfc0", "$description": "Code strings: dimmed paper." },
    "blush": { "$value": "#f5e0d6", "$description": "Light-mode selection and hover." },
    "ember": { "$value": "#4a2418", "$description": "Dark-mode selection and hover." }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{palette.paper}",
      "$extensions": { "mode": { "light": "{palette.paper}", "dark": "{palette.ink}" } }
    },
    "text": {
      "$value": "{palette.ink}",
      "$extensions": { "mode": { "light": "{palette.ink}", "dark": "{palette.paper}" } }
    },
    "text-muted": {
      "$value": "{palette.stone}",
      "$extensions": { "mode": { "light": "{palette.stone}", "dark": "{palette.stone-light}" } }
    },
    "border": {
      "$value": "{palette.ink}",
      "$description": "Rules, and the fill of every inverted band (titlebar, active tab, table head, badge).",
      "$extensions": { "mode": { "light": "{palette.ink}", "dark": "{palette.paper}" } }
    },
    "accent": {
      "$value": "{palette.rust}",
      "$description": "The orange that is readable as text on the current ground.",
      "$extensions": { "mode": { "light": "{palette.rust}", "dark": "{palette.hot-light}" } }
    },
    "accent-hot": {
      "$value": "{palette.hot}",
      "$description": "The signal fill. Same in both modes.",
      "$extensions": { "mode": { "light": "{palette.hot}", "dark": "{palette.hot}" } }
    },
    "on-hot": {
      "$value": "{palette.ink}",
      "$description": "Text on accent-hot. Same in both modes.",
      "$extensions": { "mode": { "light": "{palette.ink}", "dark": "{palette.ink}" } }
    },
    "on-accent": {
      "$value": "{palette.paper}",
      "$description": "Text on accent (inline code). Flips because accent flips.",
      "$extensions": { "mode": { "light": "{palette.paper}", "dark": "{palette.ink}" } }
    },
    "selection": {
      "$value": "{palette.blush}",
      "$extensions": { "mode": { "light": "{palette.blush}", "dark": "{palette.ember}" } }
    },
    "code-bg": {
      "$value": "{palette.ink}",
      "$extensions": { "mode": { "light": "{palette.ink}", "dark": "{palette.black}" } }
    },
    "code-fg": { "$value": "{palette.paper}" },
    "code-keyword": { "$value": "{palette.hot}" },
    "code-number": { "$value": "{palette.hot}" },
    "code-property": { "$value": "{palette.hot}" },
    "code-type": { "$value": "{palette.hot-tint}" },
    "code-string": { "$value": "{palette.sand}" },
    "code-function": { "$value": "{palette.paper}" },
    "code-comment": { "$value": "{palette.ash}" },
    "code-operator": { "$value": "{palette.ash}" }
  },
  "font": {
    "$type": "fontFamily",
    "prose": { "$value": ["Archivo", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"] },
    "display": { "$value": ["Archivo Black", "Archivo", "Impact", "system-ui", "sans-serif"] },
    "mono": { "$value": ["DM Mono", "ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "monospace"] }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500, "$description": "DM Mono only: labels, active rows, table heads." },
    "semibold": { "$value": 600, "$description": "Archivo only: strong emphasis." }
  },
  "font-size": {
    "$type": "dimension",
    "body": { "$value": "1rem" },
    "h1": { "$value": "2.3em" },
    "h2": { "$value": "1.55em" },
    "h3": { "$value": "1.2em" },
    "h4": { "$value": "1.02em" },
    "h5-h6": { "$value": "0.85em" },
    "quote": { "$value": "1.05em" },
    "inline-code": { "$value": "0.88em" },
    "code-block": { "$value": "0.85em" },
    "table": { "$value": "0.85em" },
    "micro": { "$value": "0.62rem", "$description": "Pin actions." },
    "label": { "$value": "0.66rem", "$description": "Tabs, status bar, badges." },
    "ui": { "$value": "0.7rem", "$description": "Buttons, toolbar, fence labels." },
    "note": { "$value": "0.72rem", "$description": "Titlebar name, banners, empty states." },
    "row": { "$value": "0.75rem", "$description": "List rows and inputs." },
    "panel": { "$value": "0.78rem", "$description": "Search panel." }
  },
  "letter-spacing": {
    "$type": "dimension",
    "display": { "$value": "-0.02em", "$description": "Display caps, h1 to h3." },
    "row": { "$value": "0.02em" },
    "toolbar": { "$value": "0.06em" },
    "button": { "$value": "0.08em" },
    "label": { "$value": "0.1em", "$description": "Titlebar, status bar, badges." },
    "table-head": { "$value": "0.12em" },
    "fence": { "$value": "0.16em" }
  },
  "line-height": {
    "$type": "number",
    "prose": { "$value": 1.65 },
    "display": { "$value": 1.05 },
    "quote": { "$value": 1.35 },
    "mono-heading": { "$value": 1.5 }
  },
  "rule": {
    "$type": "dimension",
    "thin": { "$value": "2px", "$description": "Control borders, table cells, toolbar group dividers, text cursor." },
    "structural": { "$value": "3px", "$description": "Pane edges, bar edges, tab underline." },
    "heavy": { "$value": "6px", "$description": "Horizontal rule in prose." },
    "slab": { "$value": "8px", "$description": "Blockquote slab." }
  },
  "size": {
    "$type": "dimension",
    "titlebar": { "$value": "38px" },
    "sidebar": { "$value": "260px" },
    "measure": { "$value": "46rem", "$description": "The writing column." },
    "gap": { "$value": "1.65rem", "$description": "One empty line of body text; the gap between blocks." },
    "icon-button": { "$value": "26px" },
    "dirty-mark": { "$value": "7px" },
    "list-gutter": { "$value": "1.6em" },
    "indent-step": { "$value": "12px", "$description": "Per tree or outline level, after an 8px base." },
    "radius": { "$value": "0", "$description": "Everywhere. The macOS app-icon mask is the only curve." }
  },
  "duration": {
    "$type": "duration",
    "dim": { "$value": "200ms", "$description": "Focus-mode dimming. The only animation in the app." }
  }
}
